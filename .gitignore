# Python
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/
.venv/

# Local Hermes/plugin data
.data/
data/
backups/
logs/
# Compat symlinks left after the plugin-data migration are regular files to
# git (mode 120000), so the trailing-slash dir patterns above do NOT match
# them and they show as untracked noise / commit bait in every status pass.
# Root-anchored patterns match both directories and the compat symlinks.
/data
/backups
/logs
*.sqlite
*.sqlite-*

# Local planning artifacts
.planning/

# Editors
.vscode/
.idea/

# uv scratch lockfile (created by `uv run` during integration validation;
# the repo pins no lockfile — dependency floors live in pyproject.toml)
uv.lock
